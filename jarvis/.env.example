ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=6WwXjDDEMyNmFG95zycZ
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# Use a language code or set this to auto for automatic detection.
ELEVENLABS_STT_LANGUAGE=eng
JARVIS_TTS_PROVIDER=elevenlabs
FISH_API_KEY=
FISH_AUDIO_REFERENCE_ID=
OLLAMA_MODEL=llama3.2:3b
# Set to 0 if GPU inference stalls; omit for automatic GPU selection.
# OLLAMA_NUM_GPU=0
# Add a Groq key to enable cloud conversation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Speech recognition. Use auto for multilingual speech.
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=en
GROQ_STT_PROMPT=JARVIS, ElevenLabs, Groq, Ollama
# Desktop microphone controls. Set JARVIS_MIC_DEVICE to the device index shown in the panel.
# JARVIS_MIC_DEVICE=0
JARVIS_MIC_SENSITIVITY=0.55
JARVIS_NOISE_SUPPRESSION=0.65
JARVIS_SILENCE_SECONDS=0.95
JARVIS_WAKE_WORD=0
JARVIS_WAKE_SENSITIVITY=0.55
# Set to 1 to open the microphone at launch in local wake-word standby.
JARVIS_MIC_AUTOSTART=0
